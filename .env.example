# ── Hugging Face ──────────────────────────────────────────────────────────────
# Your Hugging Face access token (required to download gated models like Llama 3.2).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# ── Ollama ────────────────────────────────────────────────────────────────────
# Base URL for Ollama (leave as default if running locally).
OLLAMA_BASE_URL=http://localhost:11434

# ── Training (optional overrides) ─────────────────────────────────────────────
# Base model to fine-tune (must be a Llama-3.x variant for the chat template to work).
BASE_MODEL=meta-llama/Llama-3.2-1B

# Where to save training checkpoints.
OUTPUT_DIR=meta-llama-Llama-3.2-1B-SFT

# Number of fine-tuning epochs.
NUM_EPOCHS=50

# Number of parallel workers for dataset preprocessing (reduce if you hit OOM).
NUM_PROC=4
