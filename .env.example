# ── Hugging Face ──────────────────────────────────────────────────────────────
# Your Hugging Face access token (optional for public models like Qwen 2.5, required for gated models like Llama).
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# ── Ollama ────────────────────────────────────────────────────────────────────
# Base URL for Ollama (leave as default if running locally).
OLLAMA_BASE_URL=http://localhost:11434

# ── Training (optional overrides) ─────────────────────────────────────────────
# Base model to fine-tune (e.g. Qwen/Qwen2.5-1.5B or Qwen/Qwen2.5-0.5B).
BASE_MODEL=Qwen/Qwen2.5-1.5B

# Where to save training checkpoints.
OUTPUT_DIR=qwen2.5-1.5b-SFT

# Number of fine-tuning epochs.
NUM_EPOCHS=50

# Number of parallel workers for dataset preprocessing (reduce if you hit OOM).
NUM_PROC=4
